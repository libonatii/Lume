---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import 'atropos/css';
import App from '../components/App.jsx';
---
<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e1113" />
    <meta name="description" content="Lume: biblioteca, continuidade e descobertas no seu ritmo." />
    <title>Lume — seu ritmo, seu caminho</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/lume.css?v=20261101a" />
    <style is:inline data-paper-shader></style>
    <script>
      // Service worker: casca do app em cache para abrir sem internet.
      // A API nunca é cacheada, então dados de conta continuam vindo da rede.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => { /* segue sem offline. */ });
        });
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Pular para o conteúdo</a>
    <div id="app"><App client:only="react"><p slot="fallback" class="loading-screen">Preparando seu espaço…</p></App></div>
    <noscript>Ative JavaScript para acessar sua biblioteca e guardar seu progresso.</noscript>
  </body>
</html>
