{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lume",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",

  // O Astro gera os arquivos enviados ao navegador em dist/. O resto do repositório
  // (worker.js, auth.js, migrations/, docs/) não é servido publicamente.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "build": { "command": "npm run build" },

  // Domínio próprio. O DNS fica na Cloudflare; o deploy cria os registros do Worker.
  "routes": [
    { "pattern": "lumeacademy.site", "custom_domain": true },
    { "pattern": "www.lumeacademy.site", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lume",
      "database_id": "d7de0740-0fcc-49a9-8c70-e8c4f85c5f63",
      "migrations_dir": "migrations"
    }
  ],

  // Imagens de avatar, capa e slides. Sem o binding, os uploads respondem 503.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "lume-media"
    }
  ],

  // Canal de tempo real (WebSocket): um Durable Object por pessoa, com SQLite
  // (o único tipo disponível no plano gratuito). A classe é exportada em worker.js.
  "durable_objects": {
    "bindings": [{ "name": "CHANNEL", "class_name": "UserChannel" }]
  },
  "migrations": [
    { "tag": "v1-user-channel", "new_sqlite_classes": ["UserChannel"] }
  ],

  "vars": {
    // Em produção o link de recuperação não volta na resposta da API: ele vai
    // para o log estruturado, acessível apenas ao dono da conta. Trocar por
    // "true" reabre o fluxo de teste local e não deve ser usado em site público.
    "SHOW_RESET_LINK": "false",
    "BCRYPT_ROUNDS": "6",
    // Recuperação de senha por e-mail (Resend). A chave RESEND_API_KEY é segredo:
    // `npx wrangler secret put RESEND_API_KEY`.
    "LUME_EMAIL_PROVIDER": "resend",
    "LUME_EMAIL_FROM": "Lume <nao-responda@lumeacademy.site>",
    "LUME_AI_BASE_URL": "https://generativelanguage.googleapis.com/v1beta/openai",
    "LUME_AI_MODEL": "gemini-3.5-flash-lite"
  },

  // bcrypt com custo 6 para o orçamento do Free (10 ms de CPU por requisição).
  // Abaixo do mínimo 10 recomendado pela OWASP; medir CPU após publicar.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
