{
  "manifest_version": 3,
  "name": "Lume — leitor de curso",
  "description": "Envia ao Lume as aulas e o que aparece como concluído no curso aberto com a sua conta. Não lê senha, cookie nem vídeo.",
  "version": "0.2.0",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Enviar este curso ao Lume",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://lume.lume-prototype.workers.dev/*",
    "http://localhost:4173/*",
    "http://127.0.0.1:4173/*",
    "http://localhost:4321/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lume.lume-prototype.workers.dev/*",
        "http://localhost:4173/*",
        "http://127.0.0.1:4173/*",
        "http://localhost:4321/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
